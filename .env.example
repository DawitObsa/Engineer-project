# Frontend: copy this setting to the project-root .env.local file.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Comma-separated LAN hostnames/IPs allowed to load Next.js dev assets.
NEXT_ALLOWED_DEV_ORIGINS=10.171.222.82

# API (place these in backend/.env; never commit the real values)
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/icpcas
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
INITIAL_ADMIN_SETUP_TOKEN=replace-with-a-one-time-random-setup-token
CORS_ORIGIN=http://localhost:3000
# Development-only private file storage path. Use a private object-storage adapter in production.
FILE_STORAGE_PATH=./data/private-files

# Development sample seed. Never use this on a shared/production database.
ALLOW_SAMPLE_SEED=false
SEED_ADMIN_PASSWORD= 
